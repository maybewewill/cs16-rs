(module
  (import "cs16_mod" "hook_register" (func $hook_register (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_i32" (func $hook_arg_i32 (param i32) (result i32)))
  (import "cs16_mod" "hook_arg_str" (func $hook_arg_str (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "register_command" (func $register_command (param i32 i32) (result i32)))
  (import "cs16_mod" "ent_set_health" (func $ent_set_health (param i32 f32) (result i32)))
  (import "cs16_mod" "center_print" (func $center_print (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "timer_after" (func $timer_after (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "dm_respawn")
  (data (i32.const 16) "DEATHMATCH RESPAWN")

  (func (export "cs_mod_init") (result i32)
    ;; ClientPutInServer (5) Post (1), ClientCommand (7) Pre (0)
    (drop (call $hook_register (i32.const 5) (i32.const 1) (i32.const 0)))
    (drop (call $hook_register (i32.const 7) (i32.const 0) (i32.const 0)))
    (drop (call $register_command (i32.const 0) (i32.const 10)))
    (i32.const 0)
  )

  (func (export "cs_mod_hook") (param $hid i32) (param $phase i32) (result i32)
    (local $slot i32)
    (local $len i32)
    (local.set $slot (call $hook_arg_i32 (i32.const 0)))
    (if (i32.eq (local.get $hid) (i32.const 5))
      (then
        (drop (call $ent_set_health (i32.add (local.get $slot) (i32.const 1)) (f32.const 100.0)))
        (drop (call $center_print (local.get $slot) (i32.const 16) (i32.const 18)))
        (drop (call $timer_after (i32.const 30) (i32.const 1) (local.get $slot)))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $hid) (i32.const 7))
      (then
        (local.set $len (call $hook_arg_str (i32.const 0) (i32.const 64) (i32.const 32)))
        (if (i32.and (i32.eq (local.get $len) (i32.const 10))
                     (i32.and (i32.eq (i32.load8_u (i32.const 64)) (i32.const 100))
                              (i32.eq (i32.load8_u (i32.const 65)) (i32.const 109))))
          (then
            (drop (call $ent_set_health (i32.add (local.get $slot) (i32.const 1)) (f32.const 100.0)))
            (drop (call $center_print (local.get $slot) (i32.const 16) (i32.const 18)))
            (return (i32.const 1))
          )
        )
      )
    )
    (i32.const 0)
  )

  (func (export "cs_mod_timer") (param $cb i32) (param $slot i32) (result i32)
    (if (i32.eq (local.get $cb) (i32.const 1))
      (then
        (drop (call $ent_set_health (i32.add (local.get $slot) (i32.const 1)) (f32.const 125.0)))
        (drop (call $center_print (local.get $slot) (i32.const 16) (i32.const 18)))
      )
    )
    (i32.const 0)
  )
)
