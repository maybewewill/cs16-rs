(module
  (import "cs16_mod" "hook_register" (func $hook_register (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_i32" (func $hook_arg_i32 (param i32) (result i32)))
  (import "cs16_mod" "hook_arg_str" (func $hook_arg_str (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "register_command" (func $register_command (param i32 i32) (result i32)))
  (import "cs16_mod" "storage_get" (func $storage_get (param i32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "storage_set" (func $storage_set (param i32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "say_text" (func $say_text (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "rank")
  (data (i32.const 8) "top15")
  (data (i32.const 16) "visits")
  (data (i32.const 32) "Stats Rank #1 (visits recorded)")

  (func (export "cs_mod_init") (result i32)
    (drop (call $hook_register (i32.const 5) (i32.const 1) (i32.const 0)))
    (drop (call $hook_register (i32.const 7) (i32.const 0) (i32.const 0)))
    (drop (call $register_command (i32.const 0) (i32.const 4)))
    (drop (call $register_command (i32.const 8) (i32.const 5)))
    (i32.const 0)
  )

  (func (export "cs_mod_hook") (param $hid i32) (param $phase i32) (result i32)
    (local $slot i32)
    (local $len i32)
    (local $cnt i32)
    (local.set $slot (call $hook_arg_i32 (i32.const 0)))
    (if (i32.eq (local.get $hid) (i32.const 5))
      (then
        (if (i32.gt_s (call $storage_get (i32.const 16) (i32.const 6) (i32.const 128) (i32.const 4)) (i32.const 0))
          (then (local.set $cnt (i32.sub (i32.load8_u (i32.const 128)) (i32.const 48))))
          (else (local.set $cnt (i32.const 0)))
        )
        (i32.store8 (i32.const 128) (i32.add (i32.const 49) (local.get $cnt)))
        (drop (call $storage_set (i32.const 16) (i32.const 6) (i32.const 128) (i32.const 1)))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $hid) (i32.const 7))
      (then
        (local.set $len (call $hook_arg_str (i32.const 0) (i32.const 160) (i32.const 32)))
        (if (i32.or (i32.and (i32.eq (local.get $len) (i32.const 4)) (i32.eq (i32.load8_u (i32.const 160)) (i32.const 114)))
                    (i32.and (i32.eq (local.get $len) (i32.const 5)) (i32.eq (i32.load8_u (i32.const 160)) (i32.const 116))))
          (then
            (drop (call $say_text (local.get $slot) (i32.const 32) (i32.const 31)))
            (return (i32.const 1))
          )
        )
      )
    )
    (i32.const 0)
  )
)
