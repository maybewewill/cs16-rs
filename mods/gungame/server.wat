(module
  (import "cs16_mod" "hook_register" (func $hook_register (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_i32" (func $hook_arg_i32 (param i32) (result i32)))
  (import "cs16_mod" "hook_arg_str" (func $hook_arg_str (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "register_command" (func $register_command (param i32 i32) (result i32)))
  (import "cs16_mod" "storage_get" (func $storage_get (param i32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "storage_set" (func $storage_set (param i32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "say_text" (func $say_text (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "print_all" (func $print_all (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "gg_kill")
  (data (i32.const 16) "gg_lvl")
  (data (i32.const 32) "GunGame Level Up!")
  (data (i32.const 64) "GunGame Winner!")

  (func (export "cs_mod_init") (result i32)
    (drop (call $hook_register (i32.const 7) (i32.const 0) (i32.const 0)))
    (drop (call $register_command (i32.const 0) (i32.const 7)))
    (i32.const 0)
  )

  (func (export "cs_mod_hook") (param $hid i32) (param $phase i32) (result i32)
    (local $slot i32)
    (local $len i32)
    (local $cur i32)
    (if (i32.eq (local.get $hid) (i32.const 7))
      (then
        (local.set $len (call $hook_arg_str (i32.const 0) (i32.const 128) (i32.const 32)))
        (if (i32.and (i32.eq (local.get $len) (i32.const 7))
                     (i32.and (i32.eq (i32.load8_u (i32.const 128)) (i32.const 103))
                              (i32.eq (i32.load8_u (i32.const 129)) (i32.const 103))))
          (then
            (local.set $slot (call $hook_arg_i32 (i32.const 0)))
            (if (i32.gt_s (call $storage_get (i32.const 16) (i32.const 6) (i32.const 192) (i32.const 4)) (i32.const 0))
              (then (local.set $cur (i32.sub (i32.load8_u (i32.const 192)) (i32.const 48))))
              (else (local.set $cur (i32.const 0)))
            )
            (local.set $cur (i32.add (local.get $cur) (i32.const 1)))
            (i32.store8 (i32.const 192) (i32.add (i32.const 48) (local.get $cur)))
            (drop (call $storage_set (i32.const 16) (i32.const 6) (i32.const 192) (i32.const 1)))
            (drop (call $say_text (local.get $slot) (i32.const 32) (i32.const 17)))
            (if (i32.ge_s (local.get $cur) (i32.const 3))
              (then (drop (call $print_all (i32.const 64) (i32.const 15))))
            )
            (return (i32.const 1))
          )
        )
      )
    )
    (i32.const 0)
  )
)
