(module
  (import "cs16_mod" "hud_panel" (func $panel (param f32 f32 f32 f32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "hud_draw_bar" (func $bar (param f32 f32 f32 f32 f32 i32) (result i32)))
  (import "cs16_mod" "hud_draw_text" (func $text (param f32 f32 f32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_bytes" (func $arg_bytes (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (global $pct (mut i32) (i32.const 50))
  (data (i32.const 0) "CS16-RS MOD")
  (data (i32.const 16) "Custom HUD Active")

  (func (export "cs_mod_init") (result i32)
    (i32.const 0)
  )

  (func (export "cs_mod_client_usermsg") (result i32)
    (if (i32.ge_s (call $arg_bytes (i32.const 64) (i32.const 8)) (i32.const 2))
      (then (global.set $pct (i32.load8_u (i32.const 65))))
    )
    (i32.const 0)
  )

  (func (export "cs_mod_client_hud") (param i32 i32 i32 i32)
    (drop (call $panel (f32.const 0.02) (f32.const 0.22) (f32.const 0.22) (f32.const 0.09) (i32.const 0x202820CC) (i32.const 0) (i32.const 11)))
    (drop (call $bar (f32.const 0.03) (f32.const 0.26) (f32.const 0.20) (f32.const 0.02) (f32.div (f32.convert_i32_s (global.get $pct)) (f32.const 100.0)) (i32.const 0xFFA000FF)))
    (drop (call $text (f32.const 0.03) (f32.const 0.285) (f32.const 12.0) (i32.const 0xFFFFFFFF) (i32.const 16) (i32.const 17)))
  )
)
