(module
  (import "cs16_mod" "hook_register" (func $hook_register (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_i32" (func $hook_arg_i32 (param i32) (result i32)))
  (import "cs16_mod" "hook_arg_str" (func $hook_arg_str (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "register_command" (func $register_command (param i32 i32) (result i32)))
  (import "cs16_mod" "show_menu" (func $show_menu (param i32 i32 i32 i32 i32) (result i32)))
  (import "cs16_mod" "server_exec" (func $server_exec (param i32 i32) (result i32)))
  (import "cs16_mod" "say_text" (func $say_text (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "csmod_admin")
  (data (i32.const 16) "\\yAdmin Menu\\w\n1. Kick\n2. Slay\n3. Restart Round\n4. Next Map\n\n0. Exit\n")
  (data (i32.const 128) "sv_restart 1")
  (data (i32.const 160) "Admin: Round restart")

  (func (export "cs_mod_init") (result i32)
    (drop (call $hook_register (i32.const 7) (i32.const 0) (i32.const 0)))
    (drop (call $register_command (i32.const 0) (i32.const 11)))
    (i32.const 0)
  )

  (func (export "cs_mod_hook") (param $hid i32) (param $phase i32) (result i32)
    (local $slot i32)
    (local $len i32)
    (local $arglen i32)
    (if (i32.eq (local.get $hid) (i32.const 7))
      (then
        (local.set $slot (call $hook_arg_i32 (i32.const 0)))
        (local.set $len (call $hook_arg_str (i32.const 0) (i32.const 256) (i32.const 32)))
        ;; `csmod_admin` (len 11, starts with 'c' = 99)
        (if (i32.and (i32.eq (local.get $len) (i32.const 11))
                     (i32.eq (i32.load8_u (i32.const 256)) (i32.const 99)))
          (then
            (drop (call $show_menu (local.get $slot) (i32.const 527) (i32.const 15) (i32.const 16) (i32.const 70)))
            (return (i32.const 1))
          )
        )
        ;; `menuselect 3` (cmd len 10, starts with 'm'=109, arg1 == "3")
        (if (i32.and (i32.eq (local.get $len) (i32.const 10))
                     (i32.eq (i32.load8_u (i32.const 256)) (i32.const 109)))
          (then
            (local.set $arglen (call $hook_arg_str (i32.const 1) (i32.const 300) (i32.const 8)))
            (if (i32.and (i32.eq (local.get $arglen) (i32.const 1))
                         (i32.eq (i32.load8_u (i32.const 300)) (i32.const 51)))
              (then
                (drop (call $server_exec (i32.const 128) (i32.const 12)))
                (drop (call $say_text (local.get $slot) (i32.const 160) (i32.const 20)))
                (return (i32.const 1))
              )
            )
          )
        )
      )
    )
    (i32.const 0)
  )
)
