(module
  (import "cs16_mod" "hook_register" (func $hook_register (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "hook_arg_i32" (func $hook_arg_i32 (param i32) (result i32)))
  (import "cs16_mod" "ent_set_health" (func $ent_set_health (param i32 f32) (result i32)))
  (import "cs16_mod" "center_print" (func $center_print (param i32 i32 i32) (result i32)))
  (import "cs16_mod" "precache_sound" (func $precache_sound (param i32 i32) (result i32)))
  (import "cs16_mod" "emit_sound" (func $emit_sound (param i32 i32 i32 i32 f32) (result i32)))
  (import "cs16_mod" "timer_after" (func $timer_after (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "weapons/knife_hit1.wav")
  (data (i32.const 32) "ZOMBIE OUTBREAK!")

  (func (export "cs_mod_init") (result i32)
    ;; ClientPutInServer (5) Post (1), Touch (13) Post (1)
    (drop (call $hook_register (i32.const 5) (i32.const 1) (i32.const 0)))
    (drop (call $hook_register (i32.const 13) (i32.const 1) (i32.const 0)))
    (i32.const 0)
  )

  (func (export "cs_mod_hook") (param $hid i32) (param $phase i32) (result i32)
    (local $toucher i32)
    (local $other i32)
    (if (i32.eq (local.get $hid) (i32.const 5))
      (then
        (drop (call $precache_sound (i32.const 0) (i32.const 22)))
        (drop (call $timer_after (i32.const 20) (i32.const 1) (i32.const 1)))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $hid) (i32.const 13))
      (then
        (local.set $toucher (call $hook_arg_i32 (i32.const 0)))
        (local.set $other (call $hook_arg_i32 (i32.const 1)))
        (if (i32.and (i32.eq (local.get $toucher) (i32.const 1)) (i32.gt_s (local.get $other) (i32.const 0)))
          (then
            (drop (call $ent_set_health (local.get $other) (f32.const 1500.0)))
          )
        )
      )
    )
    (i32.const 0)
  )

  (func (export "cs_mod_timer") (param $cb i32) (param $target i32) (result i32)
    (if (i32.eq (local.get $cb) (i32.const 1))
      (then
        (drop (call $ent_set_health (local.get $target) (f32.const 1500.0)))
        (drop (call $emit_sound (local.get $target) (i32.const 1) (i32.const 0) (i32.const 22) (f32.const 1.0)))
        (drop (call $center_print (i32.const -1) (i32.const 32) (i32.const 16)))
      )
    )
    (i32.const 0)
  )
)
